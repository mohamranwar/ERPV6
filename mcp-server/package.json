{
  "name": "supply-chain-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing the Sanita Supply Chain Planner: coverage, BOM costing, MRP, purchasing, logistics and customs clearance",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "supply-chain-mcp-server": "dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "build": "npm run typecheck && npm run bundle && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
